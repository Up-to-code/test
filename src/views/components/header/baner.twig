<div class="relative">
  <salla-slider
    pagination
    type="fullwidth"
    class="overflow-hidden snap-x snap-mandatory scroll-smooth"
    
    show-controls="false" 
    auto-play
  >
    <div slot="items">
      {% for baner in component.baner %}
      <div
        class="min-h-[200px] sm:min-h-[300px] md:min-h-[400px] lg:min-h-[500px] bg-cover bg-center flex items-center justify-center transition-transform duration-300 ease-in-out snap-center swiper-slide swiper-wrapper"
        style="background-image: url('{{ baner.baner_image}}');"
        aria-label="Banner {{ forloop.counter }}"
      >
        <!-- Overlay Content -->
        <div
          class="bg-black bg-opacity-50 text-white p-6 rounded-lg text-center max-w-xs md:max-w-md"
        >
          <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold">
            {{ baner.baner_title }}
          </h2>
          <p class="text-sm sm:text-base md:text-lg">{{ baner.baner_des }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </salla-slider>
</div>
