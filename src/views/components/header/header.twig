<header class="salla-header">
  <!-- Top Announcement Bar -->
  <div class="w-full bg-zinc-900 text-zinc-200 py-2 flex justify-center items-center font-semibold">
    This is a test style in Salla
  </div>

  <!-- Main Header -->
  <div class="border-b border-zinc-900 h-16 flex justify-between items-center bg-white px-6 sm:px-8 lg:px-12 gap-5">
    <!-- Logo Section -->
    <div class="flex items-center ">
      <a href="{{ store.url}}" aria-label="{{store.name}}" class="header-content-logo">
        <img src="{{ store.logo}}" width="50" height="50" alt="{{store.name}}" class="logo" />
      </a>
    </div>

    <!-- Navigation Section -->
    <div class="hidden sm:flex items-center space-x-4">
      <salla-list-tile></salla-list-tile>
    </div>

    <!-- User & Cart Section -->
    <div class="flex items-center space-x-4 justify-between gap-6 ">
      <!-- User Menu or Login -->
      {% if user.type == "user" %}
      <salla-user-menu aria-label="User menu" class="relative group">
        <i class="sicon-user text-xl text-zinc-600 hover:text-zinc-900 transition-colors duration-200"></i>
        <!-- Add a tooltip if needed for additional context -->
        <div class="absolute hidden group-hover:block bg-black text-white text-xs rounded-lg p-2 -bottom-8 left-1/2 transform -translate-x-1/2">
          User Menu
        </div>
      </salla-user-menu>
      {% else %}
      <a 
        class="login text-zinc-600 hover:text-zinc-900 transition-colors duration-200 flex items-center" 
        aria-label="Login"
        onclick="salla.event.dispatch('login::open')"
      >
        <i class="sicon-user text-xl"></i>
        <span class="sr-only">Login</span> <!-- Screen reader text -->
      </a>
      {% endif %}
    
      <!-- Cart Summary -->
      <salla-cart-summary class="relative flex items-center mx-5">
        <i class="sicon-cart text-xl text-zinc-600 hover:text-zinc-900 transition-colors duration-200" aria-label="Cart"></i>
        <!-- Cart Badge -->
      </salla-cart-summary>
   
    </div>
    
  </div>
  {% component "header.menu" %} 
</header>

